.DS_Store
_*
# `_gitignore` — служебное имя шаблона игры (см. targetName в
# packages/create-vimp-game/src/generator.js), не сама scratch-заметка
!packages/create-vimp-game/templates/default/_gitignore
node_modules/
coverage/
.TRASH
dist
logs
*.log
.env
npm-debug.log*
.certs/
.keys/

# Rust-ядро: артефакты сборки (workspace target/)
target/

# вендоренный ESM pixi.js для import map (см. scripts/sync-pixi-vendor.mjs,
# predev/prebuild) — генерируется из node_modules/pixi.js, не коммитится
packages/engine/public/vendor/pixi/

# отчёты headless-прогонов (npm run sim)
.debug/

# хранилище игровых пакетов мастера (master:gameStore:dir по умолчанию) —
# скачанные из npm registry dist/ игр, в проде это смонтированный том
.games/
