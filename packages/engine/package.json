{
  "name": "vimp-engine",
  "version": "0.4.0",
  "description": "VIMP — движок-приложение (мастер, P2P-транспорт, Worker-хост, мета, MVC-каркас клиента)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/lgick/vimp.git"
  },
  "homepage": "https://github.com/lgick/vimp#readme",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "exports": {
    "./lib/*": "./src/lib/*",
    "./config/*": "./src/config/*",
    "./host/*": "./src/host/*",
    "./devtools/*": "./src/devtools/*"
  },
  "files": [
    "src/lib",
    "src/config",
    "src/host",
    "src/devtools",
    "tests/fixtures",
    "bin"
  ],
  "scripts": {
    "predev": "node scripts/sync-pixi-vendor.mjs",
    "dev": "NODE_ENV=development nodemon src/master/main.js -w src/master -w src/lib -w src/config",
    "start": "NODE_ENV=production node --env-file ../../.env src/master/main.js",
    "prebuild": "node scripts/sync-pixi-vendor.mjs",
    "build": "vite build",
    "postbuild": "node scripts/check-importmap-csp-hash.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pixi.js": "8.19.0",
    "uuid": "^13.0.0",
    "vite-express": "^0.21.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "esbuild": "0.27.7",
    "howler": "^2.2.4",
    "nodemon": "^3.1.10",
    "vite": "^7.1.11",
    "vite-plugin-pug": "^0.4.1"
  },
  "bin": {
    "vimp-sim": "bin/vimp-sim.js"
  }
}
