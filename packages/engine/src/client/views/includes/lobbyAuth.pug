//- логин-гейт лобби (Этап B2): показывается до #lobby, пока клиент не
//- авторизован через central auth-сервис (packages/auth). Кнопки провайдеров
//- фильтруются JS по authClient.providers; неактивные скрыты
div#lobby-auth

  div#lobby-auth-login.card
    h2= 'VIMP'
    p= 'Sign in to play'
    div#lobby-auth-login-buttons
      input.lobby-auth-provider#lobby-auth-login-github(type='button', data-provider='github', value='Sign in with GitHub')
      input.lobby-auth-provider#lobby-auth-login-google(type='button', data-provider='google', value='Sign in with Google')
      input.lobby-auth-provider#lobby-auth-login-apple(type='button', data-provider='apple', value='Sign in with Apple')
    div#lobby-auth-login-error

  div#lobby-auth-nick.card(style='display:none')
    h2= 'Choose your nick'
    input#lobby-auth-nick-input.field-text(type='text', maxlength='14', placeholder='YourNick')
    div#lobby-auth-nick-error
    input#lobby-auth-nick-submit(type='button', value='Continue')
