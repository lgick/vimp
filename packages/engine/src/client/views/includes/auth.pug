//- нейтральный каркас формы авторизации: заголовок и help-секции
//- заполняет AuthView из authSchema.texts игры (AUTH_DATA, порт 1)
div#auth

  div#auth-form.card

    h2#auth-title

    div#auth-error.form-error

    div#auth-fields

    input#auth-enter(type='button', autofocus, value='Start')

    div#auth-informs

    div#auth-link
      //- ссылка и версия пакета ИГРЫ (мастер кладёт их в манифест, читая
      //- package.json пакета) — проставляет main.js по AUTH_DATA; без данных
      //- ячейки остаются пустыми
      p
        a#auth-package-link
      p#auth-version
      p &copy; #{new Date().getFullYear()} VIMP
